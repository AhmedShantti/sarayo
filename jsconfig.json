{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "jsx": "preserve",
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": ["**/*.js", "**/*.jsx"],
    "exclude": ["node_modules", ".next"]
}
